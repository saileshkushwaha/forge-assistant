// Share-Staging.xcconfig - staging Share extension overrides.
// The bundle ID must stay prefixed by App-Staging.xcconfig's, and the
// URL scheme and App Group must match that app's values exactly.

#include "Share-Base.xcconfig"

APP_GROUP_ID = group.ai.vocify-inc.forge-assistant-ios.staging
BUNDLE_DISPLAY_NAME = Forge Staging
BUNDLE_URL_SCHEME = forge-assistant-staging
PRODUCT_BUNDLE_IDENTIFIER = ai.vocify-inc.forge-assistant-ios.staging.Share

PROVISIONING_PROFILE_SPECIFIER_Manual = Forge Assistant iOS Staging Share Distribution
