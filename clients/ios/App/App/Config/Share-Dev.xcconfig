// Share-Dev.xcconfig - dev Share extension overrides.
// The bundle ID must stay prefixed by App-Dev.xcconfig's, and the URL
// scheme and App Group must match that app's values exactly.

#include "Share-Base.xcconfig"

APP_GROUP_ID = group.ai.vocify-inc.forge-assistant-ios.dev
BUNDLE_DISPLAY_NAME = Forge Dev
BUNDLE_URL_SCHEME = forge-assistant-dev
PRODUCT_BUNDLE_IDENTIFIER = ai.vocify-inc.forge-assistant-ios.dev.Share

PROVISIONING_PROFILE_SPECIFIER_Manual = Forge Assistant iOS Dev Share Distribution
