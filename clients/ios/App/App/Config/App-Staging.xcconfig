// App-Staging.xcconfig — staging target overrides.

#include "Base.xcconfig"

// Alternate app icons compiled from App/App/AvatarIcons.xcassets.
#include "AvatarIcons.xcconfig"

APP_GROUP_ID = group.ai.vocify-inc.forge-assistant-ios.staging
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon-Staging
ASSOCIATED_DOMAIN = staging-assistant.forge.ai
BUNDLE_DISPLAY_NAME = Forge Staging
BUNDLE_URL_SCHEME = forge-assistant-staging
PRODUCT_BUNDLE_IDENTIFIER = ai.vocify-inc.forge-assistant-ios.staging

// Exact portal profile name; must equal release-ios.yaml's `profile_name`.
PROVISIONING_PROFILE_SPECIFIER_Manual = Forge Assistant iOS Staging Distribution
