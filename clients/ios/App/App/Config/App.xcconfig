// App.xcconfig — production target overrides.

#include "Base.xcconfig"

// Alternate app icons compiled from App/App/AvatarIcons.xcassets.
#include "AvatarIcons.xcconfig"

APP_GROUP_ID = group.ai.vocify-inc.forge-assistant-ios
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSOCIATED_DOMAIN = www.forge.ai
BUNDLE_DISPLAY_NAME = Forge
BUNDLE_URL_SCHEME = forge-assistant
PRODUCT_BUNDLE_IDENTIFIER = ai.vocify-inc.forge-assistant-ios

// Exact portal profile name; must equal release-ios.yaml's `profile_name`.
PROVISIONING_PROFILE_SPECIFIER_Manual = Forge Assistant iOS Distribution
