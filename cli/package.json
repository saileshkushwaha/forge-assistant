{
  "name": "@forgeai/cli",
  "version": "0.11.8",
  "description": "CLI tools for forge-assistant",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./src/components/DefaultMainScreen": "./src/components/DefaultMainScreen.tsx",
    "./src/lib/constants": "./src/lib/constants.ts",
    "./src/lib/hatch-local": "./src/lib/hatch-local.ts",
    "./src/lib/retire-local": "./src/lib/retire-local.ts",
    "./src/lib/guardian-token": "./src/lib/guardian-token.ts",
    "./src/lib/lifecycle-reporter": "./src/lib/lifecycle-reporter.ts",
    "./src/commands/*": "./src/commands/*.ts"
  },
  "bin": {
    "forge": "./src/index.ts"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "lint:unused": "knip --include files,dependencies,unlisted",
    "compile:check": "bun build --compile src/index.ts --outfile /dev/null",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "author": "Forge AI",
  "license": "MIT",
  "dependencies": {
    "@forgeai/avatar-manifest": "workspace:*",
    "@forgeai/environments": "workspace:*",
    "@forgeai/ipc-server-utils": "workspace:*",
    "@forgeai/local-mode": "workspace:*",
    "@forgeai/service-contracts": "workspace:*",
    "chalk": "5.6.2",
    "ink": "6.8.0",
    "nanoid": "5.1.7",
    "qrcode-terminal": "0.12.0",
    "react": "19.2.6",
    "react-devtools-core": "7.0.1"
  },
  "bundledDependencies": [
    "@forgeai/avatar-manifest",
    "@forgeai/environments",
    "@forgeai/ipc-server-utils",
    "@forgeai/local-mode",
    "@forgeai/service-contracts"
  ],
  "devDependencies": {
    "@types/bun": "1.3.11",
    "@types/qrcode-terminal": "0.12.2",
    "@types/react": "19.2.14",
    "eslint": "10.1.0",
    "knip": "5.88.1",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.0"
  }
}
